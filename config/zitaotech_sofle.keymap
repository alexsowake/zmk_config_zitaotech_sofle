#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define FUNC 1
#define RES 2
#define BOT bootloader

/ {
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp LCLK>, <&bt BT_CLR>;
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <500>;
            bindings = <&kp &kp>;
        };
    };

    behaviors {
        sp_sc: behavior_spacescroll {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";     /* 单击优先 */
            tapping-term-ms = <200>;       /* 长按阈值 */
            bindings = <&none &kp>;        /* hold=none, tap=space */
        };
    };

    behaviors {
        BLE_encoder: BLE_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&bt BT_NXT>, <&bt BT_PRV>;
        };
    };

    macros {
        shjh_mac: shjy_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp H &kp J &kp H &kp SPACE &kp ENTER>;
            label = "SHJY_MAC";
        };

        qrrt_mac: qrrt_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Q &kp R &kp R &kp T &kp SPACE &kp RET>;
            label = "QRRT_MAC";
        };

        qrjh_mac: qrjh_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Q &kp R &kp J &kp H &kp SPACE &kp RET>;
            label = "QRJH_MAC";
        };

        dqjy_mac: dqjy_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp D &kp Q &kp J &kp Y &kp SPACE &kp RET>;
            label = "DQJY_MAC";
        };

        zjjy_mac: zjjy_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp Z &kp J &kp J &kp Y &kp SPACE &kp RET>;
            label = "ZJJY_MAC";
        };

        jdzj_mac: jdzj_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp J &kp D &kp Z &kp J &kp SPACE &kp RET>;
            label = "JDZJ_MAC";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp ESC    &kp N1    &kp N2     &kp N3     &kp N4  &kp N5  &kp C_MUTE  &kp C_MUTE  &kp N6     &kp N7     &kp N8  &kp N9     &kp N0     &kp BSPC
&kp TAB    &kp Q     &kp W      &kp E      &kp R   &kp T   &kp Y       &kp U       &kp I      &kp O      &kp P   &kp ENTER
&kp CAPS   &kp A     &kp S      &kp D      &kp F   &kp G   &mkp LCLK   &mkp LCLK   &kp H      &kp J      &kp K   &kp L      &kp SEMI   &kp ENTER
&kp LSHFT  &kp Z     &kp X      &kp C      &kp V   &kp B   &kp PG_DN   &kp PG_UP   &mkp LCLK  &mkp RCLK  &kp N   &kp M      &kp COMMA  &kp DOT    &kp FSLH  &kp SQT
&kp LALT   &kp LGUI  &kp SPACE  &kp LCTRL  &tog 2  &tog 1  &kp RCTRL   &kp SPACE   &kp RGUI   &kp RALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp LEFT RIGHT>;
        };

        func_layer {
            display-name = "FUNC";
            bindings = <
&kp GRAVE  &kp F1  &kp F2    &kp F3        &kp F4     &kp F5           &bt BT_CLR  &kp C_MUTE  &kp F6        &kp F7      &kp F8          &kp F9     &kp F10  &kp BSPC
&trans     &trans  &trans    &kp UP_ARROW  &trans     &out OUT_TOG     &kp F11     &kp F12     &kp UP_ARROW  &trans      &trans          &kp ENTER
&trans     &trans  &kp LEFT  &kp DOWN      &kp RIGHT  &trans           &mkp RCLK   &mkp RCLK   &trans        &kp LEFT    &kp DOWN_ARROW  &kp RIGHT  &trans   &kp SQT
&trans     &trans  &trans    &trans        &trans     &rgb_ug RGB_TOG  &trans      &trans      &bl BL_DEC    &bl BL_INC  &trans          &trans     &trans   &trans    &trans  &trans
&BOT       &trans  &trans    &trans        &trans     &trans           &trans      &trans      &trans        &BOT
            >;

            sensor-bindings = <&BLE_encoder &inc_dec_kp UP DOWN>;
        };

        RES_layer {
            display-name = "RESERVE";
            bindings = <
&trans    &trans     &trans         &trans          &trans     &trans         &none  &none  &none  &none  &none  &none  &none  &none
&trans    &trans     &trans         &kp UP_ARROW    &trans     &kp LC(C)      &none  &none  &none  &none  &none  &none
&trans    &zjjy_mac  &kp LEFT       &kp DOWN_ARROW  &kp RIGHT  &kp ENTER      &none  &none  &none  &none  &none  &none  &none  &none
&trans    &trans     &trans         &kp LG(C)       &kp LG(V)  &kp LS(ENTER)  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&kp RGUI  &kp LGUI   &kp LG(SPACE)  &kp RCTRL       &trans     &none          &none  &none  &none  &none
            >;
        };
    };
};
